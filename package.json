{
  "name": "brigadier",
  "productName": "Brigadier",
  "version": "0.1.0",
  "private": true,
  "main": "app/main/dist/main.js",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "start": "PATH=\"$HOME/.cargo/bin:$PATH\" BRIGADIER_BUILD=$(git rev-list --count HEAD) cargo build && pnpm build && scripts/electron .",
    "thread": "VITE_SCREEN=thread pnpm start",
    "build": "tsc -p app/main && vite build app/ui",
    "typecheck": "tsc -p app/main --noEmit && tsc -p app/ui --noEmit",
    "gallery": "scripts/gallery",
    "package": "scripts/package"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/dom": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@lexical/clipboard": "0.53.0",
    "@lexical/react": "0.53.0",
    "@lexical/utils": "0.53.0",
    "@pierre/diffs": "1.6.4",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "highlight.js": "11.12.0",
    "lexical": "0.53.0",
    "marked": "18.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-breaks": "4.0.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "virtua": "0.54.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.3",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
