#!/bin/sh
# Copies the desktop's app/shared (the non-visual code both apps share, D58) into vendor/brigadier-shared/ at one
# commit, and records it in SOURCE. Usage: scripts/sync-shared <desktop repository> [commit, default origin/main]
set -e
desk=${1:?usage: scripts/sync-shared <desktop repository> [commit]}
at=$(git -C "$desk" rev-parse "${2:-origin/main}")
out="$(dirname "$0")/../vendor/brigadier-shared"
rm -rf "$out"
mkdir -p "$out"
git -C "$desk" archive "$at" app/shared | tar -x -C "$out" --strip-components 2
echo "$at" > "$out/SOURCE"
