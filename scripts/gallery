#!/usr/bin/env bash
# Opens the component gallery in Electron and rebuilds it on every save; the window reloads itself.
set -eu
cd "$(git rev-parse --show-toplevel)"
pnpm exec tsc -p app/main
# The window opens once the first build has stamped itself.
rm -f app/ui/dist/build-id.js
node_modules/.bin/vite build app/ui --mode gallery --watch &
watcher=$! # the shim execs node, so this is the watcher itself
trap 'kill "$watcher"' EXIT
until [ -f app/ui/dist/build-id.js ]; do sleep 0.2; done
pnpm exec electron . "$@"
