#!/usr/bin/env bash
# Fails on any rule below. Limits may never be raised to get a change through.
set -u
cd "$(git rev-parse --show-toplevel)"

THEME="app/ui/src/theme.css"
AGENTS_MAX_BYTES=2050
# The line every session loads [D2025].
AGENT_LINE="crates/core/src/agent-line.txt"
AGENT_LINE_MAX_BYTES=300
MAX_LINES=500
WEB=('*.ts' '*.tsx' '*.css' '*.html' '*.js' '*.jsx' '*.mjs' '*.cjs')
NAMED_COLOURS="aliceblue|antiquewhite|aqua|aquamarine|azure|beige|bisque|black|blanchedalmond|blue|blueviolet|brown|burlywood|cadetblue|chartreuse|chocolate|coral|cornflowerblue|cornsilk|crimson|cyan|darkblue|darkcyan|darkgoldenrod|darkgray|darkgreen|darkgrey|darkkhaki|darkmagenta|darkolivegreen|darkorange|darkorchid|darkred|darksalmon|darkseagreen|darkslateblue|darkslategray|darkslategrey|darkturquoise|darkviolet|deeppink|deepskyblue|dimgray|dimgrey|dodgerblue|firebrick|floralwhite|forestgreen|fuchsia|gainsboro|ghostwhite|gold|goldenrod|gray|green|greenyellow|grey|honeydew|hotpink|indianred|indigo|ivory|khaki|lavender|lavenderblush|lawngreen|lemonchiffon|lightblue|lightcoral|lightcyan|lightgoldenrodyellow|lightgray|lightgreen|lightgrey|lightpink|lightsalmon|lightseagreen|lightskyblue|lightslategray|lightslategrey|lightsteelblue|lightyellow|lime|limegreen|linen|magenta|maroon|mediumaquamarine|mediumblue|mediumorchid|mediumpurple|mediumseagreen|mediumslateblue|mediumspringgreen|mediumturquoise|mediumvioletred|midnightblue|mintcream|mistyrose|moccasin|navajowhite|navy|oldlace|olive|olivedrab|orange|orangered|orchid|palegoldenrod|palegreen|paleturquoise|palevioletred|papayawhip|peachpuff|peru|pink|plum|powderblue|purple|rebeccapurple|red|rosybrown|royalblue|saddlebrown|salmon|sandybrown|seagreen|seashell|sienna|silver|skyblue|slateblue|slategray|slategrey|snow|springgreen|steelblue|tan|teal|thistle|tomato|turquoise|violet|wheat|white|whitesmoke|yellow|yellowgreen"

failed=0
fail() {
  echo "FAIL: $1"
  failed=1
}
# Prints matching lines in tracked and untracked (not ignored) files.
search() {
  local pattern="$1"
  shift
  git grep --untracked -InE "$pattern" -- "$@"
}
check() {
  local message="$1" found
  shift
  if found="$(search "$@")"; then
    fail "$message"
    echo "$found"
  fi
}
files() {
  git ls-files -co --exclude-standard
}

while IFS= read -r file; do
  [ -f "$file" ] || continue
  head -n 1 "$file" | grep -q '@generated' && continue
  lines="$(wc -l <"$file")"
  [ "$lines" -gt "$MAX_LINES" ] && fail "$file has $lines lines, the limit is $MAX_LINES"
done < <(files | grep -E '\.(rs|ts|tsx)$')

check "import of a banned package" '@assistant-ui|@tauri-apps' . ':!scripts/limits'

not_theme=("${WEB[@]}" ":!$THEME")
check "raw colour outside the theme file" \
  '#([0-9a-fA-F]{3,4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})([^0-9a-zA-Z_-]|$)|0x[0-9a-fA-F]{6,8}([^0-9a-fA-F]|$)|(^|[^a-zA-Z0-9_-])(rgba?|hsla?|hwb|lab|lch|oklab|oklch|color|color-mix|light-dark)\(' \
  "${not_theme[@]}"
check "named colour outside the theme file" \
  "(:[[:space:]]*|[\"'\`])($NAMED_COLOURS)([[:space:]]*(;|!|\$)|[\"'\`])" \
  "${not_theme[@]}"
check "raw length in CSS outside the theme file" \
  '(^|[^a-zA-Z0-9_#-])[0-9]*\.?[0-9]+(px|rem|em|ex|ch|cap|ic|lh|rlh|vw|vh|vi|vb|vmin|vmax|svw|svh|lvw|lvh|dvw|dvh|cqw|cqh|cqi|cqb|cqmin|cqmax|cm|mm|q|Q|in|pt|pc|%)([^a-zA-Z0-9_-]|$)' \
  '*.css' ":!$THEME"
check "Tailwind bracket value" \
  '[a-zA-Z0-9]-\[[^] ]*\]|[a-zA-Z0-9]-\(--|\[&[^] ]*\]|[@*]\[[^] ]*\]|\[--?[a-zA-Z-]+:[^] ]+\]|\[[a-z]+(-[a-z]+)*:[^] ]+\]' \
  "${not_theme[@]}"
check "colour with an opacity suffix outside the theme file" \
  '(^|[^a-zA-Z0-9_-])(bg|text|border(-[xytrblse])?|ring|ring-offset|inset-ring|outline|fill|stroke|from|via|to|shadow|inset-shadow|divide|placeholder|caret|accent|decoration)-[a-z][a-z0-9-]*/([0-9]|\(|\[)' \
  "${not_theme[@]}"
check "inline style value" \
  '(^|[^a-zA-Z0-9_-])style=|\.style([^a-zA-Z0-9_]|$)|<style|\.setProperty\(|\.cssText' \
  "${not_theme[@]}"

# What every agent loads at start: AGENTS.md and the two files it imports.
agents_bytes="$(cat AGENTS.md CONTRIBUTING.md ARCHITECTURE.md | wc -c)"
[ "$agents_bytes" -gt "$AGENTS_MAX_BYTES" ] && fail "AGENTS.md with its imports is $agents_bytes bytes, the limit is $AGENTS_MAX_BYTES"

line_bytes="$(wc -c <"$AGENT_LINE")"
[ "$line_bytes" -gt "$AGENT_LINE_MAX_BYTES" ] && fail "$AGENT_LINE is $line_bytes bytes, the limit is $AGENT_LINE_MAX_BYTES"

# The standing text each agent gets, as agent::standing joins its parts, the user's jobs left out [D527, D529];
# 40 B more for the mockup trigger [D583], 100 B for rules kept whole (owner, 2026-11-25), 60 B for the keep
# list's sentence [repo-merge D87].
S="crates/core/src/standing"
size() { cat "$@" | wc -c; }
base=$(($(size "$S"/commits.txt "$S"/lead.txt "$S"/ask.txt "$S"/voice.txt) + $(tr -d '\n' <"$AGENT_LINE" | wc -c) + 7))
for budget in "base $base 2200" "worker $((base - $(size "$S"/lead.txt) - 2)) 1710" \
  "Claude $((base + 2 + $(size "$S"/claude-todo.txt))) 2307" \
  "Codex $((base + 3 + $(size "$S"/codex-ask.txt "$S"/codex-escalate.txt))) 2552" "OpenCode $base 2200"; do
  set -- $budget
  [ "$2" -gt "$3" ] && fail "the standing text for $1 is $2 bytes, the limit is $3: shorten what you add; never another rule, ask the owner"
  # A folder chat's adds its repos rule, up to 300 B more; its map isn't counted [D494, D544].
  [ $(($2 + 2 + $(size "$S"/repos.txt))) -gt $(($3 + 300)) ] && fail "a folder chat's standing text for $1 is over its limit of $(($3 + 300)) bytes"
done

# The product's name stays only where a user or a provider's CLI meets the product itself [D269, D276]. Each kept
# mention goes once, by its file and words; what's left fails. [C] keeps these lines from matching themselves.
found="$({ git grep --untracked -IniE '[c]hat[ _-]?gpt'; files; } | sed -E \
  -e '\#^crates/core/src/adapters/codex/control\.rs:#{
s#// The [C]hatGPT app.s computer-use plugins##
s#the [C]hatGPT app.s \(node_repl\)##
s#"/[C]hatGPT\.app/"##
}' \
  -e '\#^crates/core/src/adapters/codex/mod\.rs:#{
s#learn\.[c]hatgpt\.com/docs/codex/cli##
s#https://[c]hatgpt\.com/codex/install\.sh##
s#"[C]hatGPT$##
s#said\.contains\("[C]hatGPT"\)##
s#"[C]hatGPT account"##
s#`node_repl`, the [C]hatGPT app.s MCP server##
}' \
  -e '\#^crates/core/src/adapters/codex/models\.rs:#s#"[c]hatgpt" => "[C]hatGPT account"##' |
  grep -iE '[c]hat[ _-]?gpt')" && {
  fail "a product's name outside the kept mentions: say what the behaviour or look is"
  echo "$found"
}

# Other apps' names stay only as a credit, or where the app needs them to work (browser import,
# computer use) [D23]. Each kept mention goes once, by its file and words; what's left fails.
found="$({ git grep --untracked -InE '(^|[^a-zA-Z_])([I]ntent|[D]ia|[R]EA)([^a-zA-Z_]|$)|[T]3 Code|[t]3code'; files; } | sed -E \
  -e '\#^THIRD_PARTY_NOTICES\.md:#{
s#[T]3 Code##
s#[t]3code##
}' \
  -e '\#^app/ui/src/settings/browser-import\.tsx:#s#[D]ia##' \
  -e '\#^crates/browser-data/src/chromium\.rs:#s#[D]ia##' \
  -e '\#^crates/browser-data/src/chromium/catalog\.rs:#s#[D]ia##g' \
  -e '\#^crates/browser-data/src/types\.rs:#s#[D]ia##' \
  -e '\#^crates/cli/src/computer/verbs\.rs:#s#[D]ia##g' \
  -e '\#^crates/cli/src/computer/verbs/open\.rs:#s#[D]ia##g' \
  -e '\#^crates/cli/src/computer/verbs/window\.rs:#s#[D]ia##' |
  grep -E '(^|[^a-zA-Z_])([I]ntent|[D]ia|[R]EA)([^a-zA-Z_]|$)|[T]3 Code|[t]3code')" && {
  fail "another app's name outside the kept mentions: say what the behaviour or look is"
  echo "$found"
}

found="$(git log --format='%h %B' | grep -iE '(co-authored-by|generated[- ]with)')" && {
  fail "commit with an attribution line"
  echo "$found"
}
# Commit messages say the behaviour too, as the files do [D6, D23, D269].
found="$(git log --format='%h %B' | grep -E '[Cc][Hh][Aa][Tt][ _-]?[Gg][Pp][Tt]|(^|[^a-zA-Z_])([I]ntent|[D]ia|[R]EA)([^a-zA-Z_]|$)|[T]3 ?[Cc]ode|[t]3code|(^|[^a-zA-Z0-9_])[T]3([^a-zA-Z0-9_:"]|$)')" && {
  fail "a commit message names a product or another app: say what the behaviour or look is"
  echo "$found"
}
found="$(files | grep -iE '\.md$' | grep -vxE 'README\.md|SECURITY\.md|CODE_OF_CONDUCT\.md|AGENTS\.md|CLAUDE\.md|CONTRIBUTING\.md|ARCHITECTURE\.md|THIRD_PARTY_NOTICES\.md')" && {
  fail ".md file not on the allowed list"
  echo "$found"
}

[ "$failed" -eq 0 ] && echo "limits: all passed"
exit "$failed"
