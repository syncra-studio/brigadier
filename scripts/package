#!/usr/bin/env bash
# Builds out/Brigadier-darwin-arm64/Brigadier.app, signed ad hoc. The Rust binaries ride in
# Contents/Resources/bin; the app installs them outside the bundle at launch [D40].
# APP_ID gives a test build its own bundle id, and with it its own privacy permissions.
# BRIGADIER_SIGN_IDENTITY (+ BRIGADIER_SIGN_KEYCHAIN) signs with that identity instead. Only one with an
# Apple Team ID (a Developer ID) keeps the keychain's Always Allow across builds: the keychain ties code
# without a team to each build's cdhash, so a self-signed certificate asks again every build [D492, D493].
set -eu
cd "$(git rev-parse --show-toplevel)"
export PATH="$HOME/.cargo/bin:$PATH"
# Packaged builds number themselves by commit count, as `pnpm start` does (proposed).
BRIGADIER_BUILD=$(git rev-list --count HEAD) cargo build --release --locked
pnpm build
rm -rf target/bin
mkdir target/bin
cp target/release/{brigadierd,brigadier,brigadier-host,brigadier-fake,libbrigadier_panel.dylib} target/bin/
node --input-type=module <<'EOF'
import { packager } from "@electron/packager";
// Electron's own checksums, as its installer uses: a cached zip needs no network.
import checksums from "electron/checksums.json" with { type: "json" };
// osx-sign's own defaults for an Electron app, plus Apple Events for agents that script other apps.
const entitlements = ["allow-jit", "device.audio-input", "device.bluetooth", "device.camera", "device.print", "device.usb",
  "personal-information.location", "personal-information.photos-library", "automation.apple-events"]
  .map((e) => `com.apple.security.${e.startsWith("allow") ? "cs." : ""}${e}`);
await packager({
  dir: ".",
  name: "Brigadier",
  appBundleId: process.env.APP_ID ?? "sh.brigadier.app",
  // The old app's icon, as it was: Dock, Finder and ⌘Tab.
  icon: "app/main/icons/icon.icns",
  out: "out",
  overwrite: true,
  download: { checksums },
  extraResource: ["target/bin", "THIRD_PARTY_NOTICES.md"],
  extendInfo: {
    NSAppleEventsUsageDescription: "An agent in Brigadier wants to control this app for your task.",
    // Finder's Open With on a folder [D165, D2004].
    CFBundleDocumentTypes: [{ CFBundleTypeName: "Folder", CFBundleTypeRole: "Viewer", LSHandlerRank: "Alternate", LSItemContentTypes: ["public.folder"] }],
  },
  // Only what the app reads at run time: the UI is bundled, so no node_modules; the menu bar's icon (tray.ts).
  ignore: /^\/(?!package\.json$|app($|\/main($|\/dist|\/icons($|\/tray\.png$))|\/ui($|\/dist($|\/)|\/src($|\/(theme\.css|shortcuts\.json)$))))/,
  osxSign: {
    identity: process.env.BRIGADIER_SIGN_IDENTITY || "-",
    keychain: process.env.BRIGADIER_SIGN_KEYCHAIN || undefined,
    identityValidation: false,
    // Ad hoc code has no Team ID, so hardened runtime's library validation would refuse Electron's
    // own framework. A Developer ID build turns it on: notarization requires it.
    optionsForFile: (file) => ({ timestamp: "none", hardenedRuntime: false, ...(file.endsWith("/Brigadier.app") && { entitlements }) }),
  },
});
EOF
