#!/usr/bin/env -S pnpm exec electron
// Writes the off-macOS icons from the master, app/main/icons/icon.png: icon.ico (Windows' window, taskbar, installer
// and notification area) and tray-linux.png with its @2x. Under ~32 px the master's strokes are under a pixel and blur,
// so the small sizes keep the master's tile and draw the mark as BrigadierMark's small cut (mark.tsx, D658).
// Run by hand after the master changes: scripts/icons. macOS's icon.icns and tray.png are not touched.
"use strict";
const fs = require("node:fs");
const path = require("node:path");
const { app, BrowserWindow } = require("electron");

const ICONS = path.join(__dirname, "../app/main/icons");
// 30 and 36: the taskbar's 24 px at 125% and 150%, which tray.ts hands the window.
const ICO_SIZES = [16, 20, 24, 30, 32, 36, 40, 48, 64, 256];
/** Up to this tile size the mark is drawn as the small cut. */
const SMALL_MAX = 48;

// Runs in the page: the master scaled to `size`, and for small sizes its mark painted over and drawn on whole pixels.
function draw(master, size, small) {
  // The mark's place on the master, as measured: a 256-unit grid 326 px wide round (256, 246) of 512, on a #181818 tile,
  // in #f2f5ff.
  const BOX = 326 / 512;
  const CX = 256 / 512;
  const CY = 246 / 512;
  const SMALL_BOX = 0.8;
  // mark.tsx's grid: the first column's centre, the gap between columns, each thin stroke's height.
  const FIRST_COLUMN_X = 27.2;
  const COLUMN_GAP = 14.4;
  const STRIPES = [38.4, 108.8, 145.6, 171.2, 185.6, 198.4, 204.8, 211.2, 204.8, 198.4, 185.6, 171.2, 145.6, 108.8, 38.4];
  return new Promise((resolve) => {
    const image = new Image();
    image.onload = () => {
      const canvas = document.createElement("canvas");
      canvas.width = canvas.height = size;
      const g = canvas.getContext("2d");
      g.imageSmoothingQuality = "high";
      g.drawImage(image, 0, 0, size, size);
      if (small) {
        // Bigger than the master's share (10 px of a 16 px tile reads as a blob), as small icon cuts are drawn.
        const mark = Math.round((size * SMALL_BOX) / 2) * 2;
        const left = Math.round(size * CX - mark / 2);
        const top = Math.round(size * CY - mark / 2);
        g.fillStyle = "#181818";
        g.fillRect(Math.floor(size * (CX - BOX / 2)) - 1, Math.floor(size * (CY - BOX / 2)) - 1, Math.ceil(size * BOX) + 2, Math.ceil(size * BOX) + 2);
        g.fillStyle = "#f2f5ff";
        // SmallCut in mark.tsx, on `mark` pixels: every stripe and gap a whole pixel, the middle one two, round a core.
        const unit = mark / 256;
        const outline = (x) => {
          const at = (x / unit - FIRST_COLUMN_X) / COLUMN_GAP;
          const i = Math.max(0, Math.min(STRIPES.length - 2, Math.floor(at)));
          return Math.max(0, STRIPES[i] * (1 - (at - i)) + STRIPES[i + 1] * (at - i)) * unit;
        };
        const stripe = (x, width) => {
          const height = Math.min(mark, Math.max(2, Math.round(outline(x + width / 2) / 2) * 2));
          g.fillRect(left + x, top + (mark - height) / 2, width, height);
        };
        stripe(mark / 2 - 1, 2);
        for (let x = mark / 2 - 3; x >= 0; x -= 2) stripe(x, 1), stripe(mark - 1 - x, 1);
        g.beginPath();
        g.arc(left + mark / 2, top + mark / 2, mark / 4, 0, 2 * Math.PI);
        g.fill();
      }
      resolve(canvas.toDataURL("image/png"));
    };
    image.src = master;
  });
}

/** An .ico of PNG entries, as Windows has read since Vista. */
function ico(pngs) {
  const head = Buffer.alloc(6 + 16 * pngs.length);
  head.writeUInt16LE(1, 2);
  head.writeUInt16LE(pngs.length, 4);
  let offset = head.length;
  pngs.forEach(({ size, png }, i) => {
    const at = 6 + 16 * i;
    head.writeUInt8(size % 256, at);
    head.writeUInt8(size % 256, at + 1);
    head.writeUInt16LE(1, at + 4);
    head.writeUInt16LE(32, at + 6);
    head.writeUInt32LE(png.length, at + 8);
    head.writeUInt32LE(offset, at + 12);
    offset += png.length;
  });
  return Buffer.concat([head, ...pngs.map(({ png }) => png)]);
}

app.whenReady().then(async () => {
  const page = new BrowserWindow({ show: false });
  await page.loadURL("about:blank");
  const master = `data:image/png;base64,${fs.readFileSync(path.join(ICONS, "icon.png")).toString("base64")}`;
  const render = async (size) => {
    const url = await page.webContents.executeJavaScript(`(${draw})(${JSON.stringify(master)}, ${size}, ${size <= SMALL_MAX})`);
    return { size, png: Buffer.from(url.split(",")[1], "base64") };
  };
  const pngs = [];
  for (const size of ICO_SIZES) pngs.push(await render(size));
  fs.writeFileSync(path.join(ICONS, "icon.ico"), ico(pngs));
  fs.writeFileSync(path.join(ICONS, "tray-linux.png"), pngs.find(({ size }) => size === 24).png);
  fs.writeFileSync(path.join(ICONS, "tray-linux@2x.png"), pngs.find(({ size }) => size === 48).png);
  app.quit();
});
