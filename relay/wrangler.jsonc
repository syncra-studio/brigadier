// The relay: a Worker in front, one Room Durable Object per computer. No account id here: wrangler takes it
// from the owner's login or CLOUDFLARE_ACCOUNT_ID.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brigadier-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  // Nothing about who connects is logged.
  "observability": { "enabled": false },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "Room" },
      { "name": "LOOKUP", "class_name": "Lookup" },
      { "name": "QUOTA", "class_name": "Quota" },
      { "name": "BUDGET", "class_name": "Budget" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room", "Lookup", "Quota"] },
    { "tag": "v2", "new_sqlite_classes": ["Budget"] }
  ],
  // Opens per address and route, and lookups per address, checked before any room wakes.
  "ratelimits": [
    { "name": "OPENS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "LOOKUPS", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
  ],
  "env": {
    // The owner's relay before it is public: only the rooms listed in ROOMS (comma-separated) are admitted.
    // A free room carries CEILING bytes a month (0.15 GB); BUDGET_USD is a placeholder until the owner's figure;
    // FREE_OPEN "0" stops all free traffic, open streams included. PRICE_*: Cloudflare's dollars a million requests
    // and a million GB-s, for the budget's estimate.
    "hosted": {
      "vars": {
        "HOSTED": "1",
        "ROOMS": "",
        "CEILING": "150000000",
        "BUDGET_USD": "10",
        "FREE_OPEN": "1",
        "PRICE_REQUESTS": "0.15",
        "PRICE_GB_S": "12.5"
      },
      // Push needs the owner's secrets APNS_KEY, APNS_KEY_ID and APNS_TEAM_ID (`wrangler secret put … --env hosted`);
      // a deploy without them still works, and /v1/push answers status 0 (off) until they are set.
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "Room" },
          { "name": "LOOKUP", "class_name": "Lookup" },
          { "name": "QUOTA", "class_name": "Quota" },
          { "name": "BUDGET", "class_name": "Budget" }
        ]
      },
      "ratelimits": [
        { "name": "OPENS", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
        { "name": "LOOKUPS", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } }
      ]
    }
  }
}
